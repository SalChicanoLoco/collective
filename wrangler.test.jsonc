{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "senacolectivo-test",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "test.senacolectivo.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*", "!/_astro/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "OPS_KV",
      "id": "d8d8ed19933446beb4cfd7223789d5f5"
    }
  ],
  "vars": {
    "SITE_URL": "https://test.senacolectivo.com",
    "CONTACT_EMAIL": "salvadorsena@senacolectivo.com",
    "CONTACT_PHONE": "(505) 451-9341"
  }
}
