---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "Sena's AI Collective | AI Systems, Civic Tech, and Bilingual Publication Infrastructure",
  description = "Sena's AI Collective (Sena Colectivo) builds AI systems, bilingual publication infrastructure, civic technology, local marketplaces, and Cloudflare-ready platforms from New Mexico.",
  canonical = 'https://senacolectivo.com/',
} = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: "Sena's AI Collective",
  alternateName: 'Sena Colectivo',
  url: 'https://senacolectivo.com/',
  email: 'salvadorsena@senacolectivo.com',
  telephone: '+1-505-451-9341',
  areaServed: 'New Mexico',
  founder: { '@type': 'Person', name: 'Salvador Sena' },
};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index,follow" />
  <link rel="canonical" href={canonical} />
  <meta property="og:site_name" content="Sena's AI Collective" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image" content="https://senacolectivo.com/assets/img/og-share.webp" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Sena's AI Collective — desert horizon with a cyan and gold telemetry network" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://senacolectivo.com/assets/img/og-share.webp" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body class="lang-en">
  <!-- Language boot: applies the visitor's language BEFORE first paint so there
       is no flash of the wrong language. Precedence (Salvador, 2026-11-20):
       1) manual EN/ES toggle (writes sena_lang), 2) persisted sena_lang,
       3) browser/OS locale via navigator.language(s) on first visit.
       No Google Translate / auto-translate widget — curated EN/ES copy only.
       Read-only here (never writes localStorage); site.js persists + owns the
       toggle. CSP allowlist: this exact script is hashed into worker/index.ts
       script-src ('sha256-…' — recompute if this script changes). -->
  <script is:inline>try{var s=localStorage.getItem('sena_lang');if(s!=='en'&&s!=='es'){var n=(navigator.languages&&navigator.languages[0])||navigator.language||'';s=n.toLowerCase().indexOf('es')===0?'es':'en';}document.documentElement.lang=s;document.body.classList.remove('lang-en','lang-es');document.body.classList.add('lang-'+s);}catch(e){}</script>
  <a class="skip-link en" href="#main">Skip to content</a>
  <a class="skip-link es" href="#main">Saltar al contenido</a>
  <slot />
  <script src="/assets/js/site.js" defer></script>
</body>
</html>
