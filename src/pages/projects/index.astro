---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import Card from '../../components/Card.astro';

const projects = [
  {
    kickerEn: 'Marketplace · For sale',
    kickerEs: 'Mercado · En venta',
    titleEn: 'Merc Mercado',
    descEn: 'Local handmade marketplace for Santa Fe makers on Cloudflare Pages. 0% platform take, direct buyer-seller payment.',
    descEs: 'Mercado local de artesanía para creadores de Santa Fe en Cloudflare Pages. 0% comisión, pago directo.',
    href: 'https://merc.senacolectivo.com',
    external: true,
  },
  {
    kickerEn: 'Civic publishing · Live',
    kickerEs: 'Publicación cívica · En vivo',
    titleEn: 'NewMexicoSocialists.org',
    descEn: 'Renovated public information architecture for organizing, publishing, and civic education.',
    descEs: 'Arquitectura renovada de información pública para organizar, publicar y educar a la comunidad.',
    href: 'https://newmexicosocialists.org',
    external: true,
  },
  {
    kickerEn: 'Publication system',
    kickerEs: 'Sistema de publicación',
    titleEn: 'AI Data Centers in Arid Regions',
    descEn: 'Research-to-publication workflow with public, longform, political-economics, and calculation-spine versions.',
    descEs: 'Flujo de investigación a publicación con versiones pública, extensa, de economía política y eje de cálculo.',
    href: '/publications/ai-data-centers/',
  },
  {
    kickerEn: 'Green Tech · Archival brief',
    kickerEs: 'Tecnología verde · Resumen archivado',
    titleEn: 'Future Weather EPW Morphing',
    descEn: 'Multi-pass LaTeX PDF + 6-part web package for transparent EnergyPlus Weather (EPW) climate morphing.',
    descEs: 'PDF LaTeX multipaso + paquete web de 6 partes para la transformación transparente de archivos climáticos EPW.',
    href: '/publications/future-weather-epw/',
  },
  {
    kickerEn: 'AI ecosystem',
    kickerEs: 'Ecosistema de IA',
    titleEn: 'Local Metal & Cloud TPU workflows',
    titleEs: 'Flujos en Metal local y Cloud TPU',
    descEn: 'HITL-gated Apple Silicon MLX inference, LoRA adaptation, and fail-closed verification pipelines.',
    descEs: 'Inferencia MLX en Apple Silicon con control HITL, adaptación LoRA y pipelines de verificación estricta.',
    href: 'https://github.com/SalChicanoLoco/collective',
    external: true,
    footerEn: 'View repository ↗',
    footerEs: 'Ver repositorio ↗',
  },
  {
    kickerEn: 'Resilience · CAD Studio',
    kickerEs: 'Resiliencia · Estudio CAD',
    titleEn: 'Commons Greenhouse CAD / MILPA',
    descEn: '3D orbitable CAD, 2D plan/section blueprints, and 1:50 3D-printable .STL export for passive-solar builds.',
    descEs: 'CAD 3D orbital, planos 2D de planta/sección y exportación .STL imprimible en 3D (1:50).',
    href: '/commons-greenhouse-calculator-secure/',
  },
];
---

<BaseLayout
  title="Projects | Sena's AI Collective"
  description="Sena Colectivo project index: Merc Mercado, NewMexicoSocialists.org, AI ecosystem work, civic infrastructure, and research-publication systems."
  canonical="https://senacolectivo.com/projects/"
>
  <Header />
  <main id="main">
    <PageHero
      eyebrowEn="Portfolio · prototypes · civic systems"
      eyebrowEs="Portafolio · prototipos · sistemas cívicos"
      titleEn="Projects that show the operating layer."
      titleEs="Proyectos que muestran la capa operativa."
      dekEn="Marketplaces, civic sites, custom AI workflows, research infrastructure, and community technology systems."
      dekEs="Mercados locales, sitios cívicos, flujos de IA personalizados, infraestructura de investigación y sistemas comunitarios."
      image="/assets/img/hero-mesa-network.webp"
      imageAlt="Golden survey lines and elevation ticks over Northern New Mexico arroyos and mesas at twilight."
    />

    <section class="section">
      <div class="wrap">
        <p class="eyebrow en">Index</p>
        <p class="eyebrow es">Índice</p>
        <h2 class="en">Featured Systems</h2>
        <h2 class="es">Sistemas Destacados</h2>
        <div class="grid grid--3 grid--spaced">
          {projects.map((p) => (
            <Card
              href={p.href}
              external={p.external}
              kickerEn={p.kickerEn}
              kickerEs={p.kickerEs}
              titleEn={p.titleEn}
              titleEs={p.titleEs}
              descEn={p.descEn}
              descEs={p.descEs}
            >
              {p.footerEn && (
                <span slot="footer" class="card-link-note">
                  <span class="en">{p.footerEn}</span>
                  <span class="es">{p.footerEs}</span>
                </span>
              )}
            </Card>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
