---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import Card from '../../components/Card.astro';

const publications = [
  {
    kickerEn: 'Green Tech · Peer-reviewed archival brief',
    kickerEs: 'Tecnología verde · Resumen archivado',
    titleEn: 'Future Weather EPW Morphing',
    titleEs: 'Transformación de archivos climáticos EPW futuros',
    descEn:
      'Transparent workflow for future EnergyPlus Weather (EPW) files (DOI: 10.20935/AcadEnergy8325). 6-part web package + 2-page LaTeX PDF.',
    descEs:
      'Flujo transparente para archivos futuros EnergyPlus Weather (EPW). Paquete web de 6 partes + PDF LaTeX de 2 páginas.',
    href: '/publications/future-weather-epw/',
    pdfHref: '/publications/future-weather-epw/future_weather_epw_brief.pdf',
  },
  {
    kickerEn: 'Infrastructure · 6-part package',
    kickerEs: 'Infraestructura · Paquete de 6 partes',
    titleEn: 'AI Data Centers in Arid Regions',
    titleEs: 'Centros de datos de IA en regiones áridas',
    descEn:
      'Water, power, compute, PUE/WUE calculations, and the political economy of infrastructure in New Mexico and the Southwest.',
    descEs:
      'Agua, energía, cómputo, cálculos PUE/WUE y economía política de la infraestructura en Nuevo México y el suroeste.',
    href: '/publications/ai-data-centers/',
  },
  {
    kickerEn: 'Community Systems · CC-BY',
    kickerEs: 'Sistemas comunitarios · CC-BY',
    titleEn: "The People's Greenhouse — CCGS-C1",
    titleEs: "The People's Greenhouse — CCGS-C1",
    descEn:
      'Passive solar, earth berm, thermal mass, aquaponics, and compute heat integration — architecture, heat math, and build steps.',
    descEs:
      'Solar pasiva, berma de tierra, masa térmica, acuaponía e integración de calor de cómputo — arquitectura, cálculos y construcción.',
    href: '/publications/the-peoples-greenhouse/index.html',
  },
];
---

<BaseLayout
  title="Publications | Sena's AI Collective"
  description="Public research packages, LaTeX briefs, and calculation spines from Sena's AI Collective."
  canonical="https://senacolectivo.com/publications/"
>
  <Header />
  <main id="main">
    <PageHero
      eyebrowEn="Publications · Readable, printable, inspectable"
      eyebrowEs="Publicaciones · Legibles, imprimibles, inspeccionables"
      titleEn="Public research archive."
      titleEs="Archivo público de investigación."
      dekEn="Every package includes primary sources, calculation spines, and plain-language briefs."
      dekEs="Cada paquete incluye fuentes primarias, ejes de cálculo y resúmenes en lenguaje claro."
    />

    <section class="section">
      <div class="wrap">
        <p class="eyebrow en">Index</p>
        <p class="eyebrow es">Índice</p>
        <h2 class="en">Available Packages</h2>
        <h2 class="es">Paquetes Disponibles</h2>
        <div class="grid grid--3 grid--spaced">
          {publications.map((pub) => (
            <Card
              kickerEn={pub.kickerEn}
              kickerEs={pub.kickerEs}
              titleEn={pub.titleEn}
              titleEs={pub.titleEs}
              descEn={pub.descEn}
              descEs={pub.descEs}
            >
              <div slot="footer" class="button-row">
                <a class="button button--primary en" href={pub.href}>Open package</a>
                <a class="button button--primary es" href={pub.href}>Abrir paquete</a>
                {pub.pdfHref && (
                  <>
                    <a class="button en" href={pub.pdfHref} target="_blank" rel="noopener">PDF</a>
                    <a class="button es" href={pub.pdfHref} target="_blank" rel="noopener">PDF</a>
                  </>
                )}
              </div>
            </Card>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
