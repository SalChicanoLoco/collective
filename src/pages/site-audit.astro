---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Site Audit | Sena's AI Collective"
  description="Live Cloudflare Worker header and HTML hygiene audit for HTTPS websites."
  canonical="https://senacolectivo.com/site-audit/"
>
  <Header />
  <main id="main">
    <section class="hero">
      <div class="wrap">
        <p class="eyebrow en">Edge Tool · Powered by Cloudflare Worker</p>
        <p class="eyebrow es">Herramienta de borde · Cloudflare Worker</p>
        <h1 class="en">Site Audit</h1>
        <h1 class="es">Auditoría del sitio</h1>
        <p class="dek en">
          Inspect live HTTPS security headers, HTTP status, and external dependency counts from the edge.
        </p>
        <p class="dek es">
          Inspecciona encabezados de seguridad HTTPS, estado HTTP y dependencias externas desde el borde.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <form id="audit-form" class="card">
          <label for="audit-url" class="en">HTTPS URL to audit</label>
          <label for="audit-url" class="es">URL HTTPS para auditar</label>
          <div class="button-row">
            <input
              id="audit-url"
              name="url"
              type="url"
              required
              value="https://senacolectivo.com"
              placeholder="https://example.com"
              style="flex: 1; min-width: 240px; padding: 12px; background: #1f160c; color: #f6ead7; border: 1px solid rgba(246, 234, 215, 0.25); font: inherit;"
            />
            <button type="submit" class="button button--primary en">Run audit</button>
            <button type="submit" class="button button--primary es">Ejecutar auditoría</button>
          </div>
          <p id="audit-status" class="note" role="status" aria-live="polite"></p>
        </form>

        <div id="audit-results" class="grid grid--spaced" hidden></div>
      </div>
    </section>
  </main>
  <Footer />
  <script src="/assets/js/site-audit.js" defer></script>
</BaseLayout>
