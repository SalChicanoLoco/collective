---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="Commons Greenhouse CAD & 3D Print Configurator | Sena Colectivo"
  description="Interactive 3D orbitable CAD preview, 2D plan and cross-section blueprints, 3D-printable .STL export, and .DXF CAD export for passive-solar greenhouses."
  canonical="https://senacolectivo.com/commons-greenhouse-calculator-secure/"
>
  <Header />
  <main id="main">
    <section class="hero">
      <div class="wrap">
        <p class="eyebrow en">CAD Workstation · 3D Printable .STL · 2D .DXF</p>
        <p class="eyebrow es">Estación CAD · .STL Imprimible 3D · .DXF 2D</p>
        <h1 class="en">Commons Greenhouse CAD Studio</h1>
        <h1 class="es">Estudio CAD de Invernadero Commons</h1>
        <p class="dek en">
          Configure dimensions, earth berm, trench depth, and thermal mass. Orbit the 3D model, inspect 2D blueprints, or export a 1:50 3D-printable .STL and 2D .DXF.
        </p>
        <p class="dek es">
          Configura dimensiones, berma de tierra, trinchera y masa térmica. Orbita el modelo 3D, inspecciona planos 2D o exporta .STL (1:50) y .DXF 2D.
        </p>
        <div class="button-row">
          <button type="button" id="exportStlBtn" class="button button--primary">Export 3D Printable .STL (1:50)</button>
          <button type="button" id="validateStlBtn" class="button">Validate .STL Mesh</button>
          <button type="button" id="exportDxfBtn" class="button">Export 2D CAD .DXF</button>
          <button type="button" id="resetOrbitBtn" class="button">Reset 3D View</button>
        </div>
        <p id="stlValidationStatus" class="note" role="status" aria-live="polite"></p>
      </div>
    </section>

    <section class="section">
      <div class="wrap cad-studio">
        <aside id="cadControls" class="cad-sidebar">
          <div class="card">
            <div class="kicker">Dimensions (ft)</div>
            <label for="lengthFt" class="field-label">Length X (12–96 ft)</label>
            <input id="lengthFt" class="field-input" type="number" min="12" max="96" step="2" value="32" />
            <label for="widthFt" class="field-label">Width Y (10–32 ft)</label>
            <input id="widthFt" class="field-input" type="number" min="10" max="32" step="2" value="16" />
            <label for="spacingFt" class="field-label">Hoop Spacing (2–8 ft)</label>
            <input id="spacingFt" class="field-input" type="number" min="2" max="8" step="0.5" value="4" />
          </div>

          <div class="card">
            <div class="kicker">Earthworks &amp; Aisle (ft)</div>
            <label for="aisleFt" class="field-label">Central Aisle (1.5–5 ft)</label>
            <input id="aisleFt" class="field-input" type="number" min="1.5" max="5" step="0.5" value="2.5" />
            <label for="bermFt" class="field-label">North Earth Berm (0–6 ft)</label>
            <input id="bermFt" class="field-input" type="number" min="0" max="6" step="0.5" value="2.5" />
            <label for="trenchFt" class="field-label">Sunken Trench Depth (0–4 ft)</label>
            <input id="trenchFt" class="field-input" type="number" min="0" max="4" step="0.5" value="1.5" />
          </div>

          <div class="card">
            <div class="kicker">Profile &amp; Systems</div>
            <label for="buildTier" class="field-label">Build Tier</label>
            <select id="buildTier" class="field-select">
              <option value="salvage">Scrappy Salvage ($1.85/sq ft)</option>
              <option value="balanced" selected>Balanced Low-Cost ($4.25/sq ft)</option>
              <option value="upgraded">Upgraded Kit ($8.50/sq ft)</option>
            </select>
            <label class="field-check">
              <input id="showBarrels" type="checkbox" checked /> North Thermal Barrels
            </label>
            <label class="field-check">
              <input id="showAirTube" type="checkbox" checked /> Sub-Soil Geothermal Air Tube
            </label>
            <label class="field-check">
              <input id="wireframeMode" type="checkbox" /> Wireframe CAD Mode
            </label>
          </div>
        </aside>

        <div class="cad-main">
          <div class="button-row" style="margin-top:0;">
            <button type="button" id="viewIsoBtn" class="button">Iso</button>
            <button type="button" id="viewTopBtn" class="button">Top</button>
            <button type="button" id="viewFrontBtn" class="button">Front (South)</button>
            <button type="button" id="viewSideBtn" class="button">Side (East)</button>
          </div>
          <div class="cad-frame">
            <canvas id="cadCanvas" class="cad-canvas"></canvas>
          </div>

          <div class="grid grid--4">
            <div class="card"><div class="kicker">Footprint</div><span id="footprintValue" class="stat">—</span></div>
            <div class="card"><div class="kicker">Structure</div><span id="hoopsValue" class="stat">—</span></div>
            <div class="card"><div class="kicker">Thermal Mass</div><span id="thermalValue" class="stat">—</span></div>
            <div class="card"><div class="kicker">Estimated Cost</div><span id="costValue" class="stat">—</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="eyebrow">2D CAD Blueprints &amp; Specifications</div>
        <h2>Plan, Cross-Section &amp; Bill of Materials</h2>
        <div class="grid grid--2 grid--spaced">
          <div class="card">
            <div class="kicker">Plan View (Length = X, Width = Y)</div>
            <svg id="planSvg" class="cad-svg"></svg>
          </div>
          <div class="card">
            <div class="kicker">Cross-Section (North Berm → South Glazing)</div>
            <svg id="sectionSvg" class="cad-svg"></svg>
          </div>
        </div>
        <div class="card grid--spaced">
          <div class="kicker">Derived Bill of Materials</div>
          <ul id="bomList"></ul>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script src="/assets/js/greenhouse-cad.js" defer></script>
</BaseLayout>
