---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="Commons Greenhouse CAD & 3D Print Configurator | Sena Colectivo"
  description="Interactive 3D orbitable CAD preview, 2D plan and cross-section blueprints, 3D-printable .STL export, and .DXF CAD export for passive-solar greenhouses."
  canonical="https://senacolectivo.com/commons-greenhouse-calculator-secure/"
>
  <Header />
  <main id="main">
    <section class="hero">
      <div class="wrap">
        <p class="eyebrow en">CAD Workstation · 3D Printable .STL · 2D .DXF</p>
        <p class="eyebrow es">Estación CAD · .STL Imprimible 3D · .DXF 2D</p>
        <h1 class="en">Commons Greenhouse CAD Studio</h1>
        <h1 class="es">Estudio CAD de Invernadero Commons</h1>
        <p class="dek en">
          Configure dimensions, earth berm, trench depth, and thermal mass. Orbit the 3D model, inspect 2D blueprints, or export a 1:50 3D-printable .STL and 2D .DXF.
        </p>
        <p class="dek es">
          Configura dimensiones, berma de tierra, trinchera y masa térmica. Orbita el modelo 3D, inspecciona planos 2D o exporta .STL (1:50) y .DXF 2D.
        </p>
        <div class="button-row">
          <button type="button" id="exportStlBtn" class="button button--primary"><span class="en">Export 3D Printable .STL (1:50)</span><span class="es">Exportar .STL imprimible en 3D (1:50)</span></button>
          <button type="button" id="validateStlBtn" class="button"><span class="en">Validate .STL Mesh</span><span class="es">Validar malla .STL</span></button>
          <button type="button" id="exportDxfBtn" class="button"><span class="en">Export 2D CAD .DXF</span><span class="es">Exportar .DXF CAD 2D</span></button>
          <button type="button" id="exportPltBtn" class="button"><span class="en">Export Plotter .PLT (HPGL)</span><span class="es">Exportar .PLT para plotter (HPGL)</span></button>
          <button type="button" id="printPlotBtn" class="button"><span class="en">Print Blueprint (Arch-D)</span><span class="es">Imprimir plano (Arch-D)</span></button>
          <button type="button" id="resetOrbitBtn" class="button"><span class="en">Reset 3D View</span><span class="es">Restablecer vista 3D</span></button>
        </div>
        <p id="stlValidationStatus" class="note" role="status" aria-live="polite"></p>
        <figure class="hero-media page-hero-media">
          <img
            src="/assets/img/greenhouse-cad-hero.webp"
            width="1920"
            height="1080"
            loading="lazy"
            decoding="async"
            alt="Passive-solar sunken pit greenhouse with earth berm and angled south glazing, half photorealistic and half CAD wireframe."
          />
        </figure>
      </div>
    </section>

    <section class="section">
      <div class="wrap cad-studio">
        <aside id="cadControls" class="cad-sidebar">
          <div class="card">
            <div class="kicker"><span class="en">Unit System</span><span class="es">Sistema de unidades</span></div>
            <label for="unitSystem" class="field-label">Units / Unidades</label>
            <select id="unitSystem" class="field-select">
              <option value="imperial" selected>Imperial (ft · sq ft · gal · BTU/°F)</option>
              <option value="si">SI / Metric (m · m² · L · kJ/K)</option>
            </select>
          </div>

          <div class="card">
            <div id="dimKicker" class="kicker">Dimensions (ft)</div>
            <label id="lengthLabel" for="lengthFt" class="field-label">Length X (12–96 ft)</label>
            <input id="lengthFt" class="field-input" type="number" min="12" max="96" step="2" value="32" />
            <label id="widthLabel" for="widthFt" class="field-label">Width Y (10–32 ft)</label>
            <input id="widthFt" class="field-input" type="number" min="10" max="32" step="2" value="16" />
            <label id="spacingLabel" for="spacingFt" class="field-label">Hoop Spacing (2–8 ft)</label>
            <input id="spacingFt" class="field-input" type="number" min="2" max="8" step="0.5" value="4" />
          </div>

          <div class="card">
            <div id="earthKicker" class="kicker">Earthworks &amp; Aisle (ft)</div>
            <label id="aisleLabel" for="aisleFt" class="field-label">Central Aisle (1.5–5 ft)</label>
            <input id="aisleFt" class="field-input" type="number" min="1.5" max="5" step="0.5" value="2.5" />
            <label id="bermLabel" for="bermFt" class="field-label">North Earth Berm (0–6 ft)</label>
            <input id="bermFt" class="field-input" type="number" min="0" max="6" step="0.5" value="2.5" />
            <label id="trenchLabel" for="trenchFt" class="field-label">Sunken Trench Depth (0–4 ft)</label>
            <input id="trenchFt" class="field-input" type="number" min="0" max="4" step="0.5" value="1.5" />
          </div>

          <div class="card">
            <div class="kicker"><span class="en">Profile &amp; Systems</span><span class="es">Perfil y sistemas</span></div>
            <label for="buildTier" class="field-label"><span class="en">Build Tier</span><span class="es">Nivel de construcción</span></label>
            <select id="buildTier" class="field-select">
              <option value="salvage">Scrappy Salvage ($1.85/sq ft)</option>
              <option value="balanced" selected>Balanced Low-Cost ($4.25/sq ft)</option>
              <option value="upgraded">Upgraded Kit ($8.50/sq ft)</option>
            </select>
            <label class="field-check">
              <input id="showBarrels" type="checkbox" checked /> <span class="en">North Thermal Barrels</span><span class="es">Tambos térmicos del norte</span>
            </label>
            <label class="field-check">
              <input id="showAirTube" type="checkbox" checked /> <span class="en">Sub-Soil Geothermal Air Tube</span><span class="es">Tubo geotérmico subterráneo</span>
            </label>
            <label class="field-check">
              <input id="wireframeMode" type="checkbox" /> <span class="en">Wireframe CAD Mode</span><span class="es">Modo CAD de alambre</span>
            </label>
          </div>
        </aside>

        <div class="cad-main">
          <div class="button-row" style="margin-top:0;">
            <button type="button" id="viewIsoBtn" class="button">Iso</button>
            <button type="button" id="viewTopBtn" class="button"><span class="en">Top</span><span class="es">Arriba</span></button>
            <button type="button" id="viewFrontBtn" class="button"><span class="en">Front (South)</span><span class="es">Frente (sur)</span></button>
            <button type="button" id="viewSideBtn" class="button"><span class="en">Side (East)</span><span class="es">Lado (este)</span></button>
          </div>
          <div class="cad-frame">
            <div class="cad-legend" aria-label="Legend / Leyenda">
              <span class="cad-legend__item"><span class="cad-legend__swatch"></span><span class="en">Structure</span><span class="es">Estructura</span></span>
              <span class="cad-legend__item"><span class="cad-legend__swatch cad-legend__swatch--2"></span><span class="en">Thermal mass</span><span class="es">Masa térmica</span></span>
              <span class="cad-legend__item"><span class="cad-legend__swatch"></span><span class="en">Glazing</span><span class="es">Vidrio</span></span>
              <span class="cad-legend__item"><span class="cad-legend__swatch cad-legend__swatch--2"></span><span class="en">Earthworks</span><span class="es">Tierra</span></span>
            </div>
            <canvas id="cadCanvas" class="cad-canvas"></canvas>
          </div>

          <div class="grid grid--4">
            <div class="card"><div class="kicker"><span class="en">Footprint</span><span class="es">Huella</span></div><span id="footprintValue" class="stat">—</span></div>
            <div class="card"><div class="kicker"><span class="en">Structure</span><span class="es">Estructura</span></div><span id="hoopsValue" class="stat">—</span></div>
            <div class="card"><div class="kicker"><span class="en">Thermal Mass</span><span class="es">Masa térmica</span></div><span id="thermalValue" class="stat">—</span></div>
            <div class="card"><div class="kicker"><span class="en">Estimated Cost</span><span class="es">Costo estimado</span></div><span id="costValue" class="stat">—</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="eyebrow en">Build Tiers · Material &amp; Cost Profiles</div>
        <div class="eyebrow es">Niveles de Construcción · Perfiles de Materiales</div>
        <h2 class="en">Three Greenhouse Kits Explained</h2>
        <h2 class="es">Los Tres Kits Explicados</h2>
        <div class="grid grid--3 grid--spaced">
          <article class="card">
            <div class="kicker">Tier 1 · $1.85 / sq ft ($19.91 / m²)</div>
            <h3>Scrappy Salvage</h3>
            <p class="en"><strong>Frame &amp; Cover:</strong> Reclaimed lumber or salvaged conduit ribs with single-layer greenhouse poly or salvaged glazing.</p>
            <p class="es"><strong>Estructura y Cubierta:</strong> Madera recuperada o arcos reutilizados con plástico agrícola o acristalamiento recuperado.</p>
            <p class="en"><strong>Best for:</strong> Zero-budget community pilots, backyard starter beds, and builds sourced from local salvage.</p>
            <p class="es"><strong>Ideal para:</strong> Pilotos comunitarios sin presupuesto, camas iniciales y construcciones con material reciclado.</p>
          </article>
          <article class="card">
            <div class="kicker">Tier 2 · $4.25 / sq ft ($45.75 / m²)</div>
            <h3>Balanced Low-Cost</h3>
            <p class="en"><strong>Frame &amp; Cover:</strong> 1&quot; EMT conduit or Schedule 40 PVC hoops, 6-mil UV-stabilized greenhouse poly, wiggle-wire channels, and 55-gal (208-L) black HDPE thermal barrels.</p>
            <p class="es"><strong>Estructura y Cubierta:</strong> Arcos de conduit EMT de 1&quot; o PVC cédula 40, plástico UV de 6 mil, canaletas y tambos térmicos negros de 208 L.</p>
            <p class="en"><strong>Best for:</strong> Reliable 4-season Northern New Mexico food production using standard hardware-store materials.</p>
            <p class="es"><strong>Ideal para:</strong> Producción confiable todo el año en el norte de Nuevo México con materiales de ferretería.</p>
          </article>
          <article class="card">
            <div class="kicker">Tier 3 · $8.50 / sq ft ($91.49 / m²)</div>
            <h3>Upgraded Kit</h3>
            <p class="en"><strong>Frame &amp; Cover:</strong> 1.315&quot; galvanized structural steel hoops and 8 mm twin-wall polycarbonate panels rated for high mesa wind and hail.</p>
            <p class="es"><strong>Estructura y Cubierta:</strong> Arcos de acero galvanizado de 1.315&quot; y policarbonato celular de 8 mm para viento fuerte y granizo.</p>
            <p class="en"><strong>Best for:</strong> Schools, community centers, high-wind sites, and builds ready for geothermal or hydronic heat-exchanger tie-ins.</p>
            <p class="es"><strong>Ideal para:</strong> Escuelas, centros comunitarios, zonas de viento fuerte y sistemas listos para intercambio geotérmico o hidrónico.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="eyebrow en">2D CAD Blueprints &amp; Specifications</div>
        <div class="eyebrow es">Planos CAD 2D y especificaciones</div>
        <h2 class="en">Plan, Cross-Section &amp; Bill of Materials</h2>
        <h2 class="es">Planta, corte y lista de materiales</h2>
        <div class="grid grid--2 grid--spaced">
          <div class="card">
            <div class="kicker"><span class="en">Plan View (Length = X, Width = Y)</span><span class="es">Vista en planta (largo = X, ancho = Y)</span></div>
            <svg id="planSvg" class="cad-svg"></svg>
          </div>
          <div class="card">
            <div class="kicker"><span class="en">Cross-Section (North Berm → South Glazing)</span><span class="es">Corte (berma norte → vidrio sur)</span></div>
            <svg id="sectionSvg" class="cad-svg"></svg>
          </div>
        </div>
        <div class="grid grid--2 grid--spaced">
          <div class="card">
            <div class="kicker"><span class="en">Growing Bed Dimensions &amp; Soil Volume</span><span class="es">Dimensiones de camas y volumen de suelo</span></div>
            <div style="overflow-x:auto;margin-top:0.75rem;">
              <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
                <thead>
                  <tr>
                    <th style="text-align:left;padding:6px;border-bottom:1px solid var(--border);"><span class="en">Zone</span><span class="es">Zona</span></th>
                    <th style="text-align:left;padding:6px;border-bottom:1px solid var(--border);"><span class="en">Length × Width × Depth</span><span class="es">Largo × ancho × profundidad</span></th>
                    <th style="text-align:left;padding:6px;border-bottom:1px solid var(--border);"><span class="en">Area</span><span class="es">Área</span></th>
                    <th style="text-align:left;padding:6px;border-bottom:1px solid var(--border);"><span class="en">Soil Volume</span><span class="es">Volumen de suelo</span></th>
                  </tr>
                </thead>
                <tbody id="bedDetailsBody"></tbody>
              </table>
            </div>
          </div>

          <div class="card">
            <div class="kicker"><span class="en">Materials Offsets, Clearances &amp; Earthworks</span><span class="es">Desplazamientos, holguras y movimiento de tierra</span></div>
            <ul id="offsetDetailsList" style="margin-top:0.75rem;"></ul>
          </div>
        </div>

        <div class="card grid--spaced">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
            <div class="kicker"><span class="en">Builder's Itemized Parts List &amp; Cut Schedule</span><span class="es">Lista de piezas y plan de cortes</span></div>
            <button type="button" id="exportPartsCsvBtn" class="button" style="padding:5px 12px;font-size:11px;"><span class="en">Export Parts .CSV</span><span class="es">Exportar piezas .CSV</span></button>
          </div>
          <div style="overflow-x:auto;margin-top:0.75rem;">
            <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
              <thead>
                <tr>
                  <th style="text-align:left;padding:6px;border-bottom:1px solid var(--border);"><span class="en">Item</span><span class="es">Pieza</span></th>
                  <th style="text-align:left;padding:6px;border-bottom:1px solid var(--border);"><span class="en">Qty</span><span class="es">Cant.</span></th>
                  <th style="text-align:left;padding:6px;border-bottom:1px solid var(--border);"><span class="en">Cut / Spec</span><span class="es">Corte / espec.</span></th>
                  <th style="text-align:left;padding:6px;border-bottom:1px solid var(--border);"><span class="en">Offset / Notes</span><span class="es">Desplazamiento / notas</span></th>
                </tr>
              </thead>
              <tbody id="partsTableBody"></tbody>
            </table>
          </div>
        </div>

        <div class="card grid--spaced">
          <div class="kicker"><span class="en">Derived Bill of Materials Summary</span><span class="es">Resumen de lista de materiales</span></div>
          <ul id="bomList"></ul>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script src="/assets/js/greenhouse-cad.js" defer></script>
</BaseLayout>
