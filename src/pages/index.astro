---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';

const isMaintenance = import.meta.env.PUBLIC_MAINTENANCE === 'true';
---

<BaseLayout
  title={
    isMaintenance
      ? "Sena's AI Collective | Site Revamp in Progress"
      : "Sena's AI Collective | AI Systems, Civic Tech, and Bilingual Publication Infrastructure"
  }
>
  <Header />
  {isMaintenance ? (
    <main id="main">
      <section class="hero" id="status">
        <div class="wrap hero-split">
          <div>
            <p class="eyebrow en">Maintenance in progress · New build underway</p>
            <p class="eyebrow es">Mantenimiento en curso · Nueva versión en construcción</p>
            <h1 class="en">We're rebuilding senacolectivo.com.</h1>
            <h1 class="es">Estamos reconstruyendo senacolectivo.com.</h1>
            <p class="dek en">
              Our public tools, publications, and archive are being rebuilt cleanly on Cloudflare Workers. While we finish and verify each component, the practice remains open for paid work.
            </p>
            <p class="dek es">
              Nuestras herramientas públicas, publicaciones y archivo se están reconstruyendo en Cloudflare Workers. Mientras terminamos cada componente, la práctica sigue abierta para proyectos pagados.
            </p>
            <div class="button-row">
              <a class="button button--primary en" href="mailto:salvadorsena@senacolectivo.com">Email salvadorsena@senacolectivo.com</a>
              <a class="button button--primary es" href="mailto:salvadorsena@senacolectivo.com">Escribe a salvadorsena@senacolectivo.com</a>
              <a class="button en" href="tel:+15054519341">Call (505) 451-9341</a>
              <a class="button es" href="tel:+15054519341">Llama al (505) 451-9341</a>
            </div>
          </div>
          <figure class="hero-media">
            <img
              src="/assets/img/hero-graph-mesa.webp"
              width="1920"
              height="1080"
              fetchpriority="high"
              decoding="async"
              alt="A gold network of connected nodes and lines over a dark desert mesa at dusk."
            />
          </figure>
        </div>
      </section>
    </main>
  ) : (
    <main id="main">
      <section class="hero">
        <div class="wrap hero-split">
          <div>
            <p class="eyebrow en">AI systems · civic infrastructure · bilingual publishing</p>
            <p class="eyebrow es">Sistemas de IA · infraestructura cívica · publicación bilingüe</p>
            <h1 class="en">Research, systems, and civic infrastructure for New Mexico.</h1>
            <h1 class="es">Investigación, sistemas e infraestructura cívica para Nuevo México.</h1>
            <p class="dek en">
              Sena's AI Collective builds practical AI systems, publication engines, local commerce tools, and public-interest web platforms on the edge.
            </p>
            <p class="dek es">
              Sena Colectivo construye sistemas prácticos de IA, motores de publicación, herramientas de comercio local y plataformas web de interés público en el borde.
            </p>
            <p class="hero-status en">Accepting paid projects · (505) 451-9341</p>
            <p class="hero-status es">Aceptando proyectos pagados · (505) 451-9341</p>
            <div class="button-row">
              <a class="button button--primary en" href="mailto:salvadorsena@senacolectivo.com">Start a project</a>
              <a class="button button--primary es" href="mailto:salvadorsena@senacolectivo.com">Inicia un proyecto</a>
              <a class="button en" href="tel:+15054519341">Call (505) 451-9341</a>
              <a class="button es" href="tel:+15054519341">Llama al (505) 451-9341</a>
            </div>
          </div>
          <figure class="hero-media">
            <img
              src="/assets/img/hero-graph-mesa.webp"
              width="1920"
              height="1080"
              fetchpriority="high"
              decoding="async"
              alt="A gold network of connected nodes and lines over a dark desert mesa at dusk."
            />
          </figure>
        </div>
      </section>

      <section class="section" id="services">
        <div class="wrap">
          <p class="eyebrow en">Paid work · Scope &amp; price agreed up front</p>
          <p class="eyebrow es">Trabajo pagado · Alcance y precio acordados</p>
          <h2 class="en">Hire the practice</h2>
          <h2 class="es">Contrata la práctica</h2>
          <div class="grid grid--3 grid--spaced">
            <Card
              kickerEn="Consulting · Since 2003"
              kickerEs="Consultoría · Desde 2003"
              titleEn="Sena IT & AI Services"
              titleEs="Servicios de TI e IA de Sena"
              descEn="Linux, networks, and custom AI automation for homes, schools, and small businesses in Northern New Mexico. Discounts for seniors and neighbors; trade welcome."
              descEs="Linux, redes y automatización de IA a medida para hogares, escuelas y negocios del norte de Nuevo México. Descuentos para mayores y vecinos; trueque bienvenido."
              stat="Per job"
            />
            <Card
              href="https://merc.senacolectivo.com"
              external={true}
              kickerEn="Turnkey Asset · For Sale"
              kickerEs="Activo llave en mano · En venta"
              titleEn="Merc Mercado"
              descEn="Live Santa Fe handmade marketplace on Cloudflare Pages: 0% platform take, direct buyer-seller payment, local-first commerce."
              descEs="Mercado local de artesanía para creadores de Santa Fe en Cloudflare Pages: 0% comisión, pago directo entre comprador y vendedor."
              stat="$2,500 (floor $1,000)"
            />
            <Card
              kickerEn="Service · Per project"
              kickerEs="Servicio · Por proyecto"
              titleEn="Grant Writing"
              titleEs="Redacción de Subvenciones"
              descEn="Grant writing for community projects and small organizations. Scope and price agreed before work starts."
              descEs="Redacción de subvenciones para proyectos comunitarios y organizaciones pequeñas. Alcance y precio acordados antes de empezar."
              stat="Per project"
            />
          </div>
        </div>
      </section>

      <section class="section" id="playground">
        <div class="wrap">
          <p class="eyebrow en">Edge tools &amp; public work</p>
          <p class="eyebrow es">Herramientas de borde y trabajo público</p>
          <h2 class="en">Live platforms &amp; research</h2>
          <h2 class="es">Plataformas en vivo e investigación</h2>
          <div class="grid grid--3 grid--spaced">
            <Card
              href="/commons-greenhouse-calculator-secure/"
              kickerEn="CAD Studio · 3D .STL & .DXF"
              kickerEs="Estudio CAD · .STL 3D y .DXF"
              titleEn="Commons Greenhouse CAD"
              descEn="Interactive 3D orbitable greenhouse model, 2D plan/section blueprints, and 1:50 3D-printable .STL export."
              descEs="Modelo 3D orbital, planos 2D de planta/sección y exportación .STL imprimible en 3D (1:50)."
            />
            <Card
              href="/publications/"
              kickerEn="Publications · PDF & Web"
              kickerEs="Publicaciones · PDF y Web"
              titleEn="Publication Archive"
              titleEs="Archivo de Publicaciones"
              descEn="Future Weather EPW Morphing, AI Data Centers in Arid Regions, and The People's Greenhouse."
              descEs="Transformación EPW, Centros de Datos de IA en Regiones Áridas e Invernadero del Pueblo."
            />
            <Card
              href="/biblioteca/"
              kickerEn="Archive · Bilingual"
              kickerEs="Archivo · Bilingüe"
              titleEn="La Biblioteca"
              descEn="Six-volume civic, land, water, and energy archive indexed with active publications."
              descEs="Archivo de seis volúmenes sobre lo cívico, la tierra, el agua y la energía."
            />
            <Card
              href="/projects/"
              kickerEn="Portfolio"
              kickerEs="Portafolio"
              titleEn="Projects Index"
              titleEs="Índice de Proyectos"
              descEn="Marketplaces, civic sites, local Metal & Cloud TPU workflows, and resilience systems."
              descEs="Mercados, sitios cívicos, flujos en Metal local y Cloud TPU, y sistemas de resiliencia."
            />
            <Card
              href="https://newmexicosocialists.org"
              external={true}
              kickerEn="Civic Publishing · Live"
              kickerEs="Publicación Cívica · En vivo"
              titleEn="NewMexicoSocialists.org"
              descEn="Public information architecture for organizing, publishing, and community education."
              descEs="Arquitectura de información pública para organizar, publicar y educar a la comunidad."
            />
          </div>
        </div>
      </section>

      <section class="section" id="ask">
        <div class="wrap grid grid--2">
          <div>
            <p class="eyebrow en">Edge AI · Cloudflare Workers AI</p>
            <p class="eyebrow es">IA de borde · Cloudflare Workers AI</p>
            <h2 class="en">Ask the practice</h2>
            <h2 class="es">Pregunta a la práctica</h2>
            <p class="section-lead en">
              Ask about consulting scope, Merc Mercado, or public tools — answered directly by our edge Worker.
            </p>
            <p class="section-lead es">
              Pregunta sobre consultoría, Merc Mercado o herramientas públicas — respondido desde nuestro Worker en el borde.
            </p>
            <p class="note en">
              Direct contact: <a href="mailto:salvadorsena@senacolectivo.com">salvadorsena@senacolectivo.com</a> · <a href="tel:+15054519341">(505) 451-9341</a>
            </p>
            <p class="note es">
              Contacto directo: <a href="mailto:salvadorsena@senacolectivo.com">salvadorsena@senacolectivo.com</a> · <a href="tel:+15054519341">(505) 451-9341</a>
            </p>
          </div>
          <div>
            <form id="ask-form" class="card">
              <label for="ask-input" class="field-label en">Your question (max 300 characters)</label>
              <label for="ask-input" class="field-label es">Tu pregunta (máximo 300 caracteres)</label>
              <div class="button-row">
                <input
                  id="ask-input"
                  class="field-input field-input--inline"
                  name="question"
                  type="text"
                  maxlength="300"
                  required
                  placeholder="How does pricing work for IT or AI consulting?"
                />
                <button type="submit" class="button button--primary en">Ask edge AI</button>
                <button type="submit" class="button button--primary es">Preguntar</button>
              </div>
              <p id="ask-status" class="note" role="status" aria-live="polite"></p>
            </form>
            <article id="ask-answer" class="card grid--spaced" hidden>
              <div id="ask-answer-mode" class="kicker"></div>
              <p id="ask-answer-text"></p>
            </article>
          </div>
        </div>
      </section>
    </main>
  )}
  <Footer />
  {!isMaintenance && <script src="/assets/js/ask.js" defer></script>}
</BaseLayout>
