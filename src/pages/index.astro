---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Sena's AI Collective | Site Revamp in Progress"
  description="Sena's AI Collective (Sena Colectivo) is currently rebuilding senacolectivo.com. Contact salvadorsena@senacolectivo.com or (505) 451-9341."
>
  <Header />
  <main id="main">
    <section class="hero" id="status">
      <div class="wrap">
        <p class="eyebrow en">Maintenance in progress · New build underway</p>
        <p class="eyebrow es">Mantenimiento en curso · Nueva versión en construcción</p>
        <h1 class="en">We're rebuilding senacolectivo.com.</h1>
        <h1 class="es">Estamos reconstruyendo senacolectivo.com.</h1>
        <p class="dek en">
          Our public tools, publications, and archive are being rebuilt cleanly on Cloudflare Workers. While we finish and verify each component, the practice remains open for paid work.
        </p>
        <p class="dek es">
          Nuestras herramientas públicas, publicaciones y archivo se están reconstruyendo en Cloudflare Workers. Mientras terminamos y verificamos cada componente, la práctica sigue abierta para proyectos pagados.
        </p>
        <p class="hero-status en">Accepting paid projects · (505) 451-9341</p>
        <p class="hero-status es">Aceptando proyectos pagados · (505) 451-9341</p>
        <div class="button-row">
          <a class="button button--primary en" href="mailto:salvadorsena@senacolectivo.com">Email salvadorsena@senacolectivo.com</a>
          <a class="button button--primary es" href="mailto:salvadorsena@senacolectivo.com">Escribe a salvadorsena@senacolectivo.com</a>
          <a class="button button--ghost en" href="tel:+15054519341">Call (505) 451-9341</a>
          <a class="button button--ghost es" href="tel:+15054519341">Llama al (505) 451-9341</a>
        </div>
        <figure class="hero-media">
          <img
            src="/assets/img/hero-graph-mesa.webp"
            width="1920"
            height="1080"
            fetchpriority="high"
            decoding="async"
            alt="A gold network of connected nodes and lines over a dark desert mesa at dusk."
          />
        </figure>
      </div>
    </section>

    <section class="section" id="contact">
      <div class="wrap">
        <div class="eyebrow en">Direct contact · Northern New Mexico</div>
        <div class="eyebrow es">Contacto directo · Norte de Nuevo México</div>
        <h2 class="en">Start a project while we rebuild.</h2>
        <h2 class="es">Inicia un proyecto mientras reconstruimos.</h2>
        <p class="section-lead en">
          IT &amp; AI consulting, custom systems, and grant writing. Scope and price agreed up front.
        </p>
        <p class="section-lead es">
          Consultoría de TI e IA, sistemas a medida y redacción de subvenciones. Alcance y precio acordados por adelantado.
        </p>
        <div class="grid grid--spaced">
          <article class="card">
            <div class="kicker en">Email</div>
            <div class="kicker es">Correo</div>
            <h3><a href="mailto:salvadorsena@senacolectivo.com">salvadorsena@senacolectivo.com</a></h3>
            <p class="en">Direct inbox for consulting, AI systems, and project inquiries.</p>
            <p class="es">Correo directo para consultoría, sistemas de IA y consultas de proyectos.</p>
          </article>
          <article class="card">
            <div class="kicker en">Phone</div>
            <div class="kicker es">Teléfono</div>
            <h3><a href="tel:+15054519341">(505) 451-9341</a></h3>
            <p class="en">Call or text to scope a job directly.</p>
            <p class="es">Llama o envía mensaje para acordar un trabajo directamente.</p>
          </article>
          <article class="card">
            <div class="kicker en">Live Marketplace · For sale</div>
            <div class="kicker es">Mercado en vivo · En venta</div>
            <h3><a href="https://merc.senacolectivo.com" rel="noopener">merc.senacolectivo.com</a></h3>
            <p class="en">Merc Mercado remains live on Cloudflare Pages while the main site is rebuilt.</p>
            <p class="es">Merc Mercado sigue en vivo en Cloudflare Pages mientras reconstruimos el sitio principal.</p>
          </article>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
