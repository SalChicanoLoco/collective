---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const isMaintenance = import.meta.env.PUBLIC_MAINTENANCE === 'true';
---

<BaseLayout
  title={
    isMaintenance
      ? "Sena's AI Collective | Site Revamp in Progress"
      : "Sena's AI Collective | AI Systems, Civic Tech, and Bilingual Publication Infrastructure"
  }
>
  <Header />
  {isMaintenance ? (
    <main id="main">
      <section class="hero" id="status">
        <div class="wrap hero-split">
          <div>
            <p class="eyebrow en">Maintenance in progress · New build underway</p>
            <p class="eyebrow es">Mantenimiento en curso · Nueva versión en construcción</p>
            <h1 class="en">We're rebuilding senacolectivo.com.</h1>
            <h1 class="es">Estamos reconstruyendo senacolectivo.com.</h1>
            <p class="dek en">
              Our public tools, publications, and archive are being rebuilt cleanly on Cloudflare Workers. While we finish and verify each component, the practice remains open for paid work.
            </p>
            <p class="dek es">
              Nuestras herramientas públicas, publicaciones y archivo se están reconstruyendo en Cloudflare Workers. Mientras terminamos cada componente, la práctica sigue abierta para proyectos pagados.
            </p>
            <div class="button-row">
              <a class="button button--primary en" href="mailto:salvadorsena@senacolectivo.com">Email salvadorsena@senacolectivo.com</a>
              <a class="button button--primary es" href="mailto:salvadorsena@senacolectivo.com">Escribe a salvadorsena@senacolectivo.com</a>
              <a class="button en" href="tel:+15054519341">Call (505) 451-9341</a>
              <a class="button es" href="tel:+15054519341">Llama al (505) 451-9341</a>
            </div>
          </div>
          <figure class="hero-media">
            <img
              src="/assets/img/hero-graph-mesa.webp"
              width="1920"
              height="1080"
              fetchpriority="high"
              decoding="async"
              alt="A gold network of connected nodes and lines over a dark desert mesa at dusk."
            />
          </figure>
        </div>
      </section>
    </main>
  ) : (
    <main id="main">
      <section class="hero">
        <div class="wrap hero-split">
          <div>
            <p class="eyebrow en">AI systems · civic infrastructure · bilingual publishing</p>
            <p class="eyebrow es">Sistemas de IA · infraestructura cívica · publicación bilingüe</p>
            <h1 class="en">Research, systems, and civic infrastructure for New Mexico.</h1>
            <h1 class="es">Investigación, sistemas e infraestructura cívica para Nuevo México.</h1>
            <p class="dek en">
              Sena's AI Collective builds practical AI systems, publication engines, local commerce tools, and public-interest web platforms on the edge.
            </p>
            <p class="dek es">
              Sena Colectivo construye sistemas prácticos de IA, motores de publicación, herramientas de comercio local y plataformas web de interés público en el borde.
            </p>
            <p class="hero-status en">Accepting paid projects · (505) 451-9341</p>
            <p class="hero-status es">Aceptando proyectos pagados · (505) 451-9341</p>
            <div class="button-row">
              <a class="button button--primary en" href="mailto:salvadorsena@senacolectivo.com">Start a project</a>
              <a class="button button--primary es" href="mailto:salvadorsena@senacolectivo.com">Inicia un proyecto</a>
              <a class="button en" href="tel:+15054519341">Call (505) 451-9341</a>
              <a class="button es" href="tel:+15054519341">Llama al (505) 451-9341</a>
            </div>
          </div>
          <figure class="hero-media">
            <img
              src="/assets/img/hero-graph-mesa.webp"
              width="1920"
              height="1080"
              fetchpriority="high"
              decoding="async"
              alt="A gold network of connected nodes and lines over a dark desert mesa at dusk."
            />
          </figure>
        </div>
      </section>

      <section class="section" id="services">
        <div class="wrap">
          <p class="eyebrow en">Paid work · Scope &amp; price agreed up front</p>
          <p class="eyebrow es">Trabajo pagado · Alcance y precio acordados</p>
          <h2 class="en">Hire the practice</h2>
          <h2 class="es">Contrata la práctica</h2>
          <div class="grid grid--3 grid--spaced">
            <article class="card">
              <div class="kicker en">Consulting · Since 2003</div>
              <div class="kicker es">Consultoría · Desde 2003</div>
              <h3 class="en">Sena IT &amp; AI Services</h3>
              <h3 class="es">Servicios de TI e IA de Sena</h3>
              <p class="en">
                Linux, networks, and custom AI automation for homes, schools, and small businesses in Northern New Mexico. Discounts for seniors and neighbors; trade welcome.
              </p>
              <p class="es">
                Linux, redes y automatización de IA a medida para hogares, escuelas y negocios del norte de Nuevo México. Descuentos para mayores y vecinos; trueque bienvenido.
              </p>
              <span class="stat">Per job</span>
            </article>

            <a class="card" href="https://merc.senacolectivo.com" rel="noopener">
              <div class="kicker en">Turnkey Asset · For Sale</div>
              <div class="kicker es">Activo llave en mano · En venta</div>
              <h3>Merc Mercado</h3>
              <p class="en">
                Live Santa Fe handmade marketplace on Cloudflare Pages: 0% platform take, direct buyer-seller payment, local-first commerce.
              </p>
              <p class="es">
                Mercado local de artesanía para creadores de Santa Fe en Cloudflare Pages: 0% comisión, pago directo entre comprador y vendedor.
              </p>
              <span class="stat">$2,500 (floor $1,000)</span>
            </a>

            <article class="card">
              <div class="kicker en">Service · Per project</div>
              <div class="kicker es">Servicio · Por proyecto</div>
              <h3 class="en">Grant Writing</h3>
              <h3 class="es">Redacción de Subvenciones</h3>
              <p class="en">
                Grant writing for community projects and small organizations. Scope and price agreed before work starts.
              </p>
              <p class="es">
                Redacción de subvenciones para proyectos comunitarios y organizaciones pequeñas. Alcance y precio acordados antes de empezar.
              </p>
              <span class="stat">Per project</span>
            </article>
          </div>
        </div>
      </section>

      <section class="section" id="playground">
        <div class="wrap">
          <p class="eyebrow en">Edge tools &amp; public work</p>
          <p class="eyebrow es">Herramientas de borde y trabajo público</p>
          <h2 class="en">Live platforms &amp; research</h2>
          <h2 class="es">Plataformas en vivo e investigación</h2>
          <div class="grid grid--3 grid--spaced">
            <a class="card" href="/commons-greenhouse-calculator-secure/">
              <div class="kicker en">CAD Studio · 3D .STL &amp; .DXF</div>
              <div class="kicker es">Estudio CAD · .STL 3D y .DXF</div>
              <h3>Commons Greenhouse CAD</h3>
              <p class="en">Interactive 3D orbitable greenhouse model, 2D plan/section blueprints, and 1:50 3D-printable .STL export.</p>
              <p class="es">Modelo 3D orbital, planos 2D de planta/sección y exportación .STL imprimible en 3D (1:50).</p>
            </a>
            <a class="card" href="/site-audit/">
              <div class="kicker en">Edge Audit · Worker API</div>
              <div class="kicker es">Auditoría de borde · API Worker</div>
              <h3 class="en">Site Audit (/api/audit)</h3>
              <h3 class="es">Auditoría del sitio (/api/audit)</h3>
              <p class="en">Live HTTPS security header, HTTP status, and external script/stylesheet triage.</p>
              <p class="es">Diagnóstico en vivo de encabezados HTTPS, estado HTTP y activos externos.</p>
            </a>
            <a class="card" href="/publications/">
              <div class="kicker en">Publications · PDF &amp; Web</div>
              <div class="kicker es">Publicaciones · PDF y Web</div>
              <h3 class="en">Publication Archive</h3>
              <h3 class="es">Archivo de Publicaciones</h3>
              <p class="en">Future Weather EPW Morphing, AI Data Centers in Arid Regions, and The People's Greenhouse.</p>
              <p class="es">Transformación EPW, Centros de Datos de IA en Regiones Áridas e Invernadero del Pueblo.</p>
            </a>
            <a class="card" href="/biblioteca/">
              <div class="kicker en">Archive · Bilingual</div>
              <div class="kicker es">Archivo · Bilingüe</div>
              <h3>La Biblioteca</h3>
              <p class="en">Six-volume civic, land, water, and energy archive indexed with active publications.</p>
              <p class="es">Archivo de seis volúmenes sobre lo cívico, la tierra, el agua y la energía.</p>
            </a>
            <a class="card" href="/projects/">
              <div class="kicker en">Portfolio</div>
              <div class="kicker es">Portafolio</div>
              <h3 class="en">Projects Index</h3>
              <h3 class="es">Índice de Proyectos</h3>
              <p class="en">Marketplaces, civic sites, local Metal &amp; Cloud TPU workflows, and resilience systems.</p>
              <p class="es">Mercados, sitios cívicos, flujos en Metal local y Cloud TPU, y sistemas de resiliencia.</p>
            </a>
            <a class="card" href="https://newmexicosocialists.org" rel="noopener">
              <div class="kicker en">Civic Publishing · Live</div>
              <div class="kicker es">Publicación Cívica · En vivo</div>
              <h3>NewMexicoSocialists.org</h3>
              <p class="en">Public information architecture for organizing, publishing, and community education.</p>
              <p class="es">Arquitectura de información pública para organizar, publicar y educar a la comunidad.</p>
            </a>
          </div>
        </div>
      </section>

      <section class="section" id="ask">
        <div class="wrap grid grid--2">
          <div>
            <p class="eyebrow en">Edge AI · Cloudflare Workers AI</p>
            <p class="eyebrow es">IA de borde · Cloudflare Workers AI</p>
            <h2 class="en">Ask the practice</h2>
            <h2 class="es">Pregunta a la práctica</h2>
            <p class="section-lead en">
              Ask about consulting scope, Merc Mercado, or public tools — answered directly by our edge Worker.
            </p>
            <p class="section-lead es">
              Pregunta sobre consultoría, Merc Mercado o herramientas públicas — respondido desde nuestro Worker en el borde.
            </p>
            <p class="note en">
              Direct contact: <a href="mailto:salvadorsena@senacolectivo.com">salvadorsena@senacolectivo.com</a> · <a href="tel:+15054519341">(505) 451-9341</a>
            </p>
            <p class="note es">
              Contacto directo: <a href="mailto:salvadorsena@senacolectivo.com">salvadorsena@senacolectivo.com</a> · <a href="tel:+15054519341">(505) 451-9341</a>
            </p>
          </div>
          <div>
            <form id="ask-form" class="card">
              <label for="ask-input" class="field-label en">Your question (max 300 characters)</label>
              <label for="ask-input" class="field-label es">Tu pregunta (máximo 300 caracteres)</label>
              <div class="button-row">
                <input
                  id="ask-input"
                  class="field-input field-input--inline"
                  name="question"
                  type="text"
                  maxlength="300"
                  required
                  placeholder="How does pricing work for IT or AI consulting?"
                />
                <button type="submit" class="button button--primary en">Ask edge AI</button>
                <button type="submit" class="button button--primary es">Preguntar</button>
              </div>
              <p id="ask-status" class="note" role="status" aria-live="polite"></p>
            </form>
            <article id="ask-answer" class="card grid--spaced" hidden>
              <div id="ask-answer-mode" class="kicker"></div>
              <p id="ask-answer-text"></p>
            </article>
          </div>
        </div>
      </section>
    </main>
  )}
  <Footer />
  {!isMaintenance && <script src="/assets/js/ask.js" defer></script>}
</BaseLayout>
