---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHero from '../../../components/PageHero.astro';
---

<BaseLayout
  title="Quetzal Planetary Geophysics (Experimental) | Sena's AI Collective"
  description="Experimental planetary geophysics showcase: live USGS seismic radiance in Joules, NOAA WMM2025 geodynamo reference, and strict edge rate/budget caps."
  canonical="https://senacolectivo.com/tools/quetzal/"
>
  <Header />
  <main id="main">
    <PageHero
      eyebrowEn="Experimental · Rate-Capped · Zero Paid AI Calls"
      eyebrowEs="Experimental · Con Límite de Tasa · Cero Costo de IA"
      titleEn="Quetzal Planetary Geophysics"
      titleEs="Geofísica Planetaria Quetzal"
      dekEn="Live USGS M2.5+ seismic radiance in Joules (Gutenberg-Choy), NOAA WMM2025 geodynamo baselines, and 4D resistivity provenance — cached at the edge for 5 minutes and capped at 15 req/min/IP."
      dekEs="Radiancia sísmica USGS M2.5+ en Joules (Gutenberg-Choy), referencia geodinámica WMM2025 y proveniencia estricta — con caché de 5 minutos y límite de 15 sol/min/IP."
    />

    <section class="section">
      <div class="wrap">
        <div class="hero-split">
          <div>
            <p class="eyebrow">Architecture &amp; Data Provenance</p>
            <h2>Observational ingestion meets deterministic physics.</h2>
            <p>
              <strong>Quetzal Planetary Geophysics</strong> separates raw scientific telemetry from deterministic constitutive kernels so language models never fabricate physical numbers. Live earthquakes arrive from the public <strong>USGS NEIC M2.5+ GeoJSON feed</strong>, geomagnetic drift is anchored to <strong>NOAA NCEI WMM2025</strong> and <strong>ESA Swarm</strong> baselines, and subsurface resistivity, Yellowstone thermo-rheology, Brune fault mechanics, and InSAR deformation run on bounded mathematical engines.
            </p>
            <p>
              To protect upstream APIs and prevent runaway billing, this public surface makes <strong>zero paid LLM or Google AI calls</strong>. Live USGS telemetry is cached in Cloudflare <code>OPS_KV</code> for 5 minutes and capped at <code>15 req/min/IP</code>, while all Joules and TNT calculations execute locally in your browser.
            </p>
            <div class="button-row">
              <a class="button button--primary" href="/publications/quetzal-geophysics/">Read Quetzal Whitepaper</a>
              <a class="button" href="https://quetzal-geophysics-x7l7o3xjza-uc.a.run.app" target="_blank" rel="noopener">Quetzal Cloud Run Engine</a>
              <a class="button" href="https://yellowstone-geophysics-x7l7o3xjza-uc.a.run.app" target="_blank" rel="noopener">Yellowstone Rheology App</a>
              <a class="button" href="/tools/">All Tools</a>
            </div>
          </div>

          <div class="card">
            <div class="kicker">Live Telemetry &amp; Budget Pipeline</div>
            <svg viewBox="0 0 420 210" style="width:100%;height:auto;display:block;margin-top:6px;" aria-label="Quetzal data flow from USGS and NOAA through 5-minute OPS_KV edge cache to client browser">
              <rect x="10" y="16" width="118" height="54" rx="6" fill="var(--surface-2)" stroke="var(--accent)" stroke-width="1.2" />
              <text x="69" y="38" fill="var(--accent)" font-size="10" font-family="var(--mono)" text-anchor="middle">USGS NEIC</text>
              <text x="69" y="54" fill="var(--muted)" font-size="9" font-family="var(--mono)" text-anchor="middle">M2.5+ GeoJSON</text>

              <rect x="10" y="84" width="118" height="54" rx="6" fill="var(--surface-2)" stroke="var(--accent-2)" stroke-width="1.2" />
              <text x="69" y="106" fill="var(--accent-2)" font-size="10" font-family="var(--mono)" text-anchor="middle">NOAA / SWARM</text>
              <text x="69" y="122" fill="var(--muted)" font-size="9" font-family="var(--mono)" text-anchor="middle">WMM2025 Drift</text>

              <line x1="128" y1="43" x2="158" y2="75" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="4 3" />
              <line x1="128" y1="111" x2="158" y2="85" stroke="var(--accent-2)" stroke-width="1.5" stroke-dasharray="4 3" />

              <rect x="158" y="42" width="118" height="72" rx="6" fill="var(--surface)" stroke="var(--accent)" stroke-width="1.5" />
              <text x="217" y="66" fill="var(--text)" font-size="10.5" font-family="var(--mono)" font-weight="700" text-anchor="middle">OPS_KV CACHE</text>
              <text x="217" y="83" fill="var(--accent)" font-size="9.5" font-family="var(--mono)" text-anchor="middle">5-min TTL</text>
              <text x="217" y="99" fill="var(--muted)" font-size="9" font-family="var(--mono)" text-anchor="middle">Cap: 15/min/IP</text>

              <line x1="276" y1="78" x2="302" y2="78" stroke="var(--accent)" stroke-width="1.5" />

              <rect x="302" y="42" width="108" height="72" rx="6" fill="var(--surface-2)" stroke="var(--border-strong)" stroke-width="1.2" />
              <text x="356" y="66" fill="var(--text)" font-size="10" font-family="var(--mono)" font-weight="700" text-anchor="middle">BROWSER</text>
              <text x="356" y="83" fill="var(--accent-2)" font-size="9.5" font-family="var(--mono)" text-anchor="middle">Joules + TNT</text>
              <text x="356" y="99" fill="var(--muted)" font-size="9" font-family="var(--mono)" text-anchor="middle">$0 Paid AI</text>

              <rect x="10" y="156" width="400" height="38" rx="6" fill="var(--bg)" stroke="var(--border)" />
              <text x="210" y="179" fill="var(--muted)" font-size="9.5" font-family="var(--mono)" text-anchor="middle">PROVENANCE: OBSERVED · DERIVED · INVERTED · MODELED</text>
            </svg>
          </div>
        </div>

        <div class="grid grid--4 grid--spaced">
          <div class="card"><div class="kicker">North Dip-Pole Drift</div><span class="stat">~36.0 km/yr</span></div>
          <div class="card"><div class="kicker">Outer Core (PREM)</div><span class="stat">3,480 km</span></div>
          <div class="card"><div class="kicker">Curie Isotherm</div><span class="stat">573 °C</span></div>
          <div class="card"><div class="kicker">Google AI Cost</div><span class="stat">$0.00 (Capped)</span></div>
        </div>

        <div class="grid grid--3 grid--spaced">
          <article class="card">
            <div class="kicker">Live on Web · Budget-Capped</div>
            <h3>Seismic &amp; Geodynamo</h3>
            <ul>
              <li><code>/api/quetzal/seismic</code> — Live USGS NEIC M2.5+ feed (5-min KV cache, 15/min IP cap).</li>
              <li><strong>Gutenberg-Choy Engine</strong> — Client-side broadband radiance in Joules &amp; TNT eq.</li>
              <li><strong>WMM2025 / Swarm</strong> — Secular pole drift &amp; cross-modal decoupling invariants.</li>
            </ul>
          </article>
          <article class="card">
            <div class="kicker">MCP / Backend Modules</div>
            <h3>Subsurface &amp; Crustal</h3>
            <ul>
              <li><strong>4D Resistivity Inversion</strong> — Spatiotemporal <math><mrow><mi>ρ</mi><mo>(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo>,</mo><mi>t</mi><mo>)</mo></mrow></math> via Koefoed 1D engine.</li>
              <li><strong>Yellowstone Rheology</strong> — Sibson-Byerlee, Kirby-Kronenberg &amp; 573°C Curie BDT.</li>
              <li><strong>Brune Fault &amp; InSAR</strong> — Stress drop, slip-rate, and crustal deformation models.</li>
            </ul>
          </article>
          <article class="card">
            <div class="kicker">Epistemic &amp; Moral Floor</div>
            <h3>Provenance &amp; Ahimsa</h3>
            <ul>
              <li><strong>Mandatory Tags:</strong> <code>OBSERVED</code>, <code>DERIVED</code>, <code>INVERTED</code>, or <code>MODELED</code> + UTC timestamp.</li>
              <li><strong>Ahimsa &amp; Ital:</strong> Non-lethal, zero-spoofing, &lt;1.8W edge-efficiency design.</li>
            </ul>
          </article>
        </div>

        <div class="grid grid--2 grid--spaced">
          <div class="card">
            <div class="kicker">Gutenberg-Choy Seismic Radiance Calculator</div>
            <math display="block" aria-label="log10 E_s equals 4.8 plus 1.5 M">
              <mrow>
                <msub><mi>log</mi><mn>10</mn></msub><mo>(</mo><msub><mi>E</mi><mi>s</mi></msub><mo>)</mo>
                <mo>=</mo><mn>4.8</mn><mo>+</mo><mn>1.5</mn><mi>M</mi>
              </mrow>
            </math>
            <label for="qzMagInput" class="field-label">Magnitude (M): <strong id="qzMagVal">3.5</strong></label>
            <input id="qzMagInput" class="field-input" type="range" min="1.0" max="9.0" step="0.1" value="3.5" />
            <div class="grid grid--2" style="margin-top:0.75rem;">
              <div><div class="kicker">Radiated Energy</div><span id="qzEnergyOut" class="stat">—</span></div>
              <div><div class="kicker">TNT Equivalent</div><span id="qzTntOut" class="stat">—</span></div>
            </div>
          </div>

          <div class="card">
            <div class="kicker">NOAA WMM2025 / Swarm Geodynamo Reference</div>
            <ul>
              <li><strong>North Dip-Pole Drift (2025/2026):</strong> ~36.0 km/yr (decelerating from ~45.0 km/yr peak)</li>
              <li><strong>South Dip-Pole Drift:</strong> ~9.0 km/yr</li>
              <li><strong>Dipole Moment:</strong> 7.78 × 10²² A·m² · <strong>Tilt:</strong> 9.3°</li>
              <li><strong>Outer Core Radius (PREM):</strong> 3,480 km · <strong>Re_m:</strong> 350</li>
              <li><strong>Decoupling Invariant:</strong> Core MHD operates on multi-decadal timescales; temporal overlap does not imply crustal earthquake causation.</li>
            </ul>
          </div>
        </div>

        <div class="card grid--spaced">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
            <div class="kicker">3D Planetary Globe · AOI Targeting · Experimental Forecast · Google Earth .KML</div>
            <div class="button-row" style="margin:0;">
              <button type="button" id="qzFetchBtn" class="button button--primary">Load Live USGS Telemetry</button>
              <a id="qzEarthLink" class="button" href="https://earth.google.com/web/@35.7,-105.9,1800a,900000d,35y,0h,45t,0r" target="_blank" rel="noopener">Open in Google Earth 3D</a>
              <button type="button" id="qzKmlBtn" class="button">Export Google Earth .KML</button>
              <button type="button" id="qzGeoJsonBtn" class="button">Export .GeoJSON</button>
            </div>
          </div>

          <div class="cad-studio" style="margin-top:1rem;">
            <div class="cad-sidebar">
              <div class="kicker">AOI (Area of Interest)</div>
              <label for="qzAoiPreset" class="field-label">Region Preset</label>
              <select id="qzAoiPreset" class="field-select">
                <option value="nm" selected>Northern NM / Rio Grande Rift (35.7°N, -105.9°W)</option>
                <option value="yellowstone">Yellowstone Caldera (44.4°N, -110.6°W)</option>
                <option value="ca">SoCal / San Andreas (34.0°N, -118.4°W)</option>
                <option value="ak">Alaska Subduction (57.0°N, -154.0°W)</option>
              </select>
              <label for="qzAoiLat" class="field-label">Center Latitude (°)</label>
              <input id="qzAoiLat" class="field-input" type="number" step="0.1" min="-90" max="90" value="35.7" />
              <label for="qzAoiLon" class="field-label">Center Longitude (°)</label>
              <input id="qzAoiLon" class="field-input" type="number" step="0.1" min="-180" max="180" value="-105.9" />
              <label for="qzAoiRadius" class="field-label">AOI Radius (km)</label>
              <input id="qzAoiRadius" class="field-input" type="number" step="50" min="50" max="5000" value="500" />

              <div class="kicker" style="margin-top:1rem;">Experimental Forecast (Poisson / G-R)</div>
              <p class="note" style="font-size:12px;margin-top:4px;">
                <strong>Experimental only:</strong> Empirical 24h rate scaled to 7-day Poisson exceedance within AOI. Not an official prediction.
              </p>
              <ul id="qzForecastList" style="list-style:none;padding:0;margin:6px 0 0;font-family:var(--mono);font-size:12px;">
                <li>AOI Events (24h): <strong id="qzAoiCount">—</strong></li>
                <li>AOI Energy (24h): <strong id="qzAoiEnergy">—</strong></li>
                <li>7d P(M ≥ 3.0): <strong id="qzProbM3">—</strong></li>
                <li>7d P(M ≥ 4.0): <strong id="qzProbM4">—</strong></li>
                <li>7d P(M ≥ 5.0): <strong id="qzProbM5">—</strong></li>
              </ul>
            </div>

            <div class="cad-main">
              <div class="cad-frame">
                <canvas id="qzGlobe" width="640" height="380" class="cad-canvas" style="height:380px;"></canvas>
              </div>
              <p id="qzStatus" class="note" role="status" aria-live="polite">Drag the 3D globe to rotate · Click "Load Live USGS Telemetry" to plot live events &amp; compute AOI forecast.</p>
            </div>
          </div>

          <div style="overflow-x:auto;margin-top:1rem;">
            <table>
              <thead>
                <tr>
                  <th>Mag</th>
                  <th>Location</th>
                  <th>Coords</th>
                  <th>Depth</th>
                  <th>Energy (GJ)</th>
                  <th>AOI Dist</th>
                  <th>UTC Time</th>
                </tr>
              </thead>
              <tbody id="qzEventsBody"></tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script src="/assets/js/quetzal.js" defer></script>
</BaseLayout>
