---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import Card from '../../components/Card.astro';

const tools = [
  {
    kickerEn: 'CAD Studio · 3D .STL & .DXF',
    kickerEs: 'Estudio CAD · .STL 3D y .DXF',
    titleEn: 'Commons Greenhouse CAD',
    titleEs: 'CAD de Invernadero Commons',
    descEn: '3D orbitable model, 2D plan and section blueprints, 1:50 .STL 3D-print export, and 2D .DXF export.',
    descEs: 'Modelo 3D orbital, planos 2D de planta y sección, exportación .STL 3D (1:50) y .DXF 2D.',
    href: '/commons-greenhouse-calculator-secure/',
  },
  {
    kickerEn: 'Archive · Bilingual',
    kickerEs: 'Archivo · Bilingüe',
    titleEn: 'La Biblioteca',
    titleEs: 'La Biblioteca',
    descEn: 'Six-volume civic research archive indexed alongside active publication packages.',
    descEs: 'Archivo de investigación cívica de seis volúmenes indexado junto con publicaciones activas.',
    href: '/biblioteca/',
  },
];
---

<BaseLayout
  title="Tools | Sena's AI Collective"
  description="Sena Colectivo tools: 3D CAD greenhouse configurator (Imperial & SI), 2D blueprints, and bilingual research archives."
  canonical="https://senacolectivo.com/tools/"
>
  <Header />
  <main id="main">
    <PageHero
      eyebrowEn="CAD · Blueprints · Archives"
      eyebrowEs="CAD · Planos · Archivos"
      titleEn="Tools that make the research operational."
      titleEs="Herramientas que vuelven operativa la investigación."
      dekEn="Two tools, both live: the Commons Greenhouse CAD Studio (3D-printable, Imperial & SI) and La Biblioteca, the six-volume bilingual research archive."
      dekEs="Dos herramientas, ambas en vivo: el Estudio CAD de Invernadero Commons (imprimible en 3D, Imperial y SI) y La Biblioteca, el archivo bilingüe de seis volúmenes."
    />

    <section class="section">
      <div class="wrap">
        <p class="eyebrow en">Index</p>
        <p class="eyebrow es">Índice</p>
        <h2 class="en">Operational Tools</h2>
        <h2 class="es">Herramientas Operativas</h2>
        <div class="grid grid--2 grid--spaced">
          {tools.map((t) => (
            <Card
              href={t.href}
              kickerEn={t.kickerEn}
              kickerEs={t.kickerEs}
              titleEn={t.titleEn}
              titleEs={t.titleEs}
              descEn={t.descEn}
              descEs={t.descEs}
            />
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
