---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
---

<BaseLayout
  title="Ops & Management Hub | Sena Colectivo"
  description="Token-gated Edge AI, Delta Quadrant Substrate, Route Health, and Private Site Audit console."
  canonical="https://senacolectivo.com/admin/"
>
  <Header />
  <main id="main">
    <PageHero
      eyebrowEn="Private Ops Hub · Fail-Closed · Zero-Cookie"
      eyebrowEs="Centro de Operaciones · Cierre Seguro · Sin Cookies"
      titleEn="Collective Ops & Edge AI Hub"
      titleEs="Centro de Operaciones e IA en el Borde"
      dekEn="Authenticate with SUBSTRATE_TOKEN to inspect Tier 1/2/3 substrate health, run private site audits, check routes, and test inference."
      dekEs="Autentícate con SUBSTRATE_TOKEN para inspeccionar el sustrato, ejecutar auditorías privadas, verificar rutas y probar inferencia."
    />

    <section class="section">
      <div class="wrap">
        <div class="card">
          <div class="kicker"><span class="en">Auth Gate · sessionStorage only</span><span class="es">Acceso · solo sessionStorage</span></div>
          <form id="adminAuthForm" class="button-row" style="margin-top:0.75rem;">
            <input
              id="adminTokenInput"
              class="field-input field-input--inline"
              type="password"
              autocomplete="off"
              placeholder="Paste SUBSTRATE_TOKEN (Bearer)"
              required
            />
            <button type="submit" class="button button--primary"><span class="en">Connect</span><span class="es">Conectar</span></button>
            <button type="button" id="adminLockBtn" class="button"><span class="en">Lock / Clear</span><span class="es">Bloquear / Limpiar</span></button>
            <button type="button" id="adminRefreshBtn" class="button"><span class="en">Refresh Status</span><span class="es">Actualizar estado</span></button>
          </form>
          <p id="adminAuthStatus" class="note" role="status" aria-live="polite"></p>
        </div>

        <div class="grid grid--4 grid--spaced">
          <div class="card"><div class="kicker">Tier 1 · Kernel</div><span id="statTier1" class="stat">—</span></div>
          <div class="card"><div class="kicker">Tier 2 · Workers AI</div><span id="statTier2" class="stat">—</span></div>
          <div class="card"><div class="kicker">Tier 3 · Custom LM</div><span id="statTier3" class="stat">—</span></div>
          <div class="card"><div class="kicker">/api/ask Rate Limit</div><span id="statRate" class="stat">—</span></div>
        </div>

        <div class="grid grid--2 grid--spaced">
          <div class="card">
            <div class="kicker"><span class="en">Route Health Check</span><span class="es">Verificación de rutas</span></div>
            <p class="note en">Verifies live HTTP status across core pages and API endpoints.</p>
            <p class="note es">Verifica el estado HTTP en vivo de las páginas principales y los endpoints de la API.</p>
            <button type="button" id="runHealthBtn" class="button button--primary"><span class="en">Run Route Health Check</span><span class="es">Verificar rutas</span></button>
            <pre id="healthOutput" class="note" style="margin-top:0.75rem;overflow-x:auto;">Not run yet.</pre>
          </div>

          <div class="card">
            <div class="kicker"><span class="en">Private Edge Tool Audit (/api/audit)</span><span class="es">Auditoría privada de herramienta edge (/api/audit)</span></div>
            <form id="auditForm" class="button-row" style="margin-top:0.75rem;">
              <input
                id="auditUrlInput"
                class="field-input field-input--inline"
                type="url"
                value="https://test.senacolectivo.com"
                required
              />
              <button type="submit" class="button button--primary"><span class="en">Audit URL</span><span class="es">Auditar URL</span></button>
            </form>
            <pre id="auditOutput" class="note" style="margin-top:0.75rem;overflow-x:auto;">Requires SUBSTRATE_TOKEN.</pre>
          </div>
        </div>

        <div class="card grid--spaced">
          <div class="kicker"><span class="en">Tier 3 Substrate Inference Test (/api/substrate/infer)</span><span class="es">Prueba de inferencia del sustrato Tier 3 (/api/substrate/infer)</span></div>
          <form id="inferForm" class="button-row" style="margin-top:0.75rem;">
            <input
              id="inferPromptInput"
              class="field-input field-input--inline"
              type="text"
              value="Summarize the 3-tier substrate status in two sentences."
              required
            />
            <button type="submit" class="button button--primary"><span class="en">Run Tier 3 / Fallback</span><span class="es">Probar Tier 3 / Respaldo</span></button>
          </form>
          <pre id="inferOutput" class="note" style="margin-top:0.75rem;overflow-x:auto;">Requires SUBSTRATE_TOKEN.</pre>
        </div>

        <div class="grid grid--2 grid--spaced">
          <div class="card">
            <div class="kicker"><span class="en">Runtime Ops Config (OPS_KV)</span><span class="es">Configuración en Tiempo Real (OPS_KV)</span></div>
            <form id="opsConfigForm" style="margin-top:0.75rem;">
              <label class="field-check">
                <input id="cfgAskEnabled" type="checkbox" checked />
                <span class="en">Enable Public Edge AI (/api/ask)</span>
                <span class="es">Habilitar IA en el Borde (/api/ask)</span>
              </label>
              <label for="cfgRateLimit" class="field-label">
                <span class="en">Rate Limit (requests / min / IP, 1–120)</span>
                <span class="es">Límite de tasa (solicitudes / min / IP, 1–120)</span>
              </label>
              <input id="cfgRateLimit" class="field-input" type="number" min="1" max="120" value="20" required />
              <label for="cfgFactsAppend" class="field-label">
                <span class="en">Live Edge AI Facts Append (max 500 chars)</span>
                <span class="es">Notas verificadas en vivo para IA (máx. 500)</span>
              </label>
              <input id="cfgFactsAppend" class="field-input" type="text" maxlength="500" placeholder="Optional verified note appended to system prompt" />
              <div class="button-row" style="margin-top:0.9rem;">
                <button type="submit" class="button button--primary"><span class="en">Save Runtime Config</span><span class="es">Guardar Configuración</span></button>
              </div>
              <p id="cfgSaveStatus" class="note" role="status" aria-live="polite"></p>
            </form>
          </div>

          <div class="card">
            <div class="kicker"><span class="en">Admin Security Audit Log</span><span class="es">Registro de Auditoría de Seguridad</span></div>
            <pre id="auditLogOutput" class="note" style="margin-top:0.75rem;overflow-x:auto;">Connect to view OPS_KV audit trail.</pre>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script src="/assets/js/admin.js" defer></script>
</BaseLayout>
