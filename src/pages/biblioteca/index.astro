---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import Card from '../../components/Card.astro';

const volumes = [
  { num: 'Vol. 1', href: '/biblioteca/vol1/index.html', titleEn: 'Foundations & Land', titleEs: 'Fundamentos y Tierra' },
  { num: 'Vol. 2', href: '/biblioteca/vol2/index.html', titleEn: 'Water & Acequias', titleEs: 'Agua y Acequias' },
  { num: 'Vol. 3', href: '/biblioteca/vol3/index.html', titleEn: 'Labor & Economy', titleEs: 'Trabajo y Economía' },
  { num: 'Vol. 4', href: '/biblioteca/vol4/index.html', titleEn: 'Energy & Arid Grid', titleEs: 'Energía y Red Árida' },
  { num: 'Vol. 5', href: '/biblioteca/vol5/index.html', titleEn: 'Build MILPA', titleEs: 'Construye MILPA' },
  { num: 'Vol. 6', href: '/biblioteca/vol6/index.html', titleEn: 'Civic Infrastructure', titleEs: 'Infraestructura Cívica' },
];

const linkedPubs = [
  {
    kicker: 'DOI: 10.20935/AcadEnergy8325',
    titleEn: 'Future Weather EPW Morphing',
    titleEs: 'Transformación EPW de clima futuro',
    href: '/publications/future-weather-epw/',
  },
  {
    kicker: 'PUE / WUE · Arid Basins',
    titleEn: 'AI Data Centers in Arid Regions',
    titleEs: 'Centros de datos de IA en regiones áridas',
    href: '/publications/ai-data-centers/',
  },
  {
    kicker: 'CCGS-C1 · CC-BY',
    titleEn: "The People's Greenhouse",
    titleEs: "The People's Greenhouse",
    href: '/publications/the-peoples-greenhouse/index.html',
  },
];
---

<BaseLayout
  title="La Biblioteca | Sena's AI Collective"
  description="La Biblioteca: bilingual civic, land, water, energy, and greenhouse research archive indexed with Sena Colectivo publications."
  canonical="https://senacolectivo.com/biblioteca/"
>
  <Header />
  <main id="main">
    <PageHero
      eyebrowEn="La Biblioteca · Bilingual Research Archive"
      eyebrowEs="La Biblioteca · Archivo de Investigación Bilingüe"
      titleEn="Volumes & published research."
      titleEs="Volúmenes e investigación publicada."
      dekEn="Long-form civic, land, water, labor, and climate-resilience volumes paired directly with our active publication packages."
      dekEs="Volúmenes sobre lo cívico, la tierra, el agua, el trabajo y la resiliencia climática vinculados con nuestras publicaciones activas."
    />

    <section class="section">
      <div class="wrap">
        <p class="eyebrow en">Six-Volume Archive</p>
        <p class="eyebrow es">Archivo de seis volúmenes</p>
        <h2 class="en">La Biblioteca Volumes</h2>
        <h2 class="es">Volúmenes de La Biblioteca</h2>
        <div class="grid grid--3 grid--spaced">
          {volumes.map((vol) => (
            <Card href={vol.href} kickerEn={vol.num} titleEn={vol.titleEn} titleEs={vol.titleEs} />
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <p class="eyebrow en">Indexed from /publications/</p>
        <p class="eyebrow es">Indexado desde /publications/</p>
        <h2 class="en">Active Publication Packages</h2>
        <h2 class="es">Paquetes de Publicación Activos</h2>
        <div class="grid grid--3 grid--spaced">
          {linkedPubs.map((pub) => (
            <Card href={pub.href} kickerEn={pub.kicker} titleEn={pub.titleEn} titleEs={pub.titleEs} />
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
