---
const isMaintenance = import.meta.env.PUBLIC_MAINTENANCE === 'true';

const navItems = isMaintenance
  ? [
      { href: '#status', en: 'Status', es: 'Estado' },
      { href: '#contact', en: 'Contact', es: 'Contacto' },
      { href: 'https://merc.senacolectivo.com', en: 'Merc Mercado', es: 'Merc Mercado' },
    ]
  : [
      { href: '/#services', en: 'Services', es: 'Servicios' },
      { href: '/#playground', en: 'Playground', es: 'Proyectos' },
      { href: '/#proof', en: 'Proof', es: 'Prueba' },
      { href: '/publications/', en: 'Publications', es: 'Publicaciones' },
      { href: '/projects/', en: 'Projects', es: 'Portafolio' },
      { href: '/tools/', en: 'Tools', es: 'Herramientas' },
      { href: '/biblioteca/', en: 'La Biblioteca', es: 'La Biblioteca' },
      { href: '/site-audit/', en: 'Site Audit', es: 'Auditoría' },
      { href: '/#contact', en: 'Contact', es: 'Contacto' },
    ];
---

<header class="site-masthead">
  <div class="site-masthead__inner">
    <div>
      <a class="brand" href="/">Sena's AI Collective</a>
      <p class="brand-sub">Sena Colectivo · New Mexico</p>
    </div>
    <nav aria-label="Main navigation">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a href={item.href}>
              {item.en === item.es ? (
                item.en
              ) : (
                <>
                  <span class="en">{item.en}</span>
                  <span class="es">{item.es}</span>
                </>
              )}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="lang-toggle" role="group" aria-label="Language">
      <button type="button" data-lang-button="en" aria-pressed="true">EN</button>
      <button type="button" data-lang-button="es" aria-pressed="false">ES</button>
    </div>
  </div>
</header>
