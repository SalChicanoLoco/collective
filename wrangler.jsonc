{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "senacolectivo-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "senacolectivo.com/*", "zone_name": "senacolectivo.com" },
    { "pattern": "www.senacolectivo.com/*", "zone_name": "senacolectivo.com" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/favicon.ico"]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "SITE_URL": "https://senacolectivo.com",
    "CONTACT_EMAIL": "salvadorsena@senacolectivo.com",
    "CONTACT_PHONE": "(505) 451-9341"
  }
}
