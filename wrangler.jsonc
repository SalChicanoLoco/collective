{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "senacolectivo-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "senacolectivo.com", "custom_domain": true },
    { "pattern": "www.senacolectivo.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SITE_URL": "https://senacolectivo.com",
    "CONTACT_EMAIL": "salvadorsena@senacolectivo.com",
    "CONTACT_PHONE": "(505) 451-9341"
  }
}
