@article{Reolon2026_EnergyPlusWeather,
  author       = {Reolon, Mattia and Marengo, Marco and Picco, Marco},
  title        = {A transparent workflow for future {EnergyPlus} Weather ({EPW}) files for building energy simulation},
  journal      = {Academia Green Energy},
  volume       = {3},
  pages        = {1--16},
  year         = {2026},
  month        = may,
  publisher    = {Academia.edu Journals},
  doi          = {10.20935/AcadEnergy8325},
  issn         = {2998-3665},
  url          = {https://doi.org/10.20935/AcadEnergy8325},
  keywords     = {future weather files, EPW, morphing, climate projections, building energy modelling, climate adaptation},
  abstract     = {Building performance assessments frequently rely on historical weather files that do not represent future climatic conditions, introducing uncertainty and risk for long-lived buildings and low-carbon design decisions. This paper presents a transparent and replicable method to generate future EnergyPlus Weather (EPW) files by morphing a baseline EPW file, derived from typical meteorological year (TMY) datasets representative of recent historical climate conditions, using monthly climate anomalies derived from a Global Climate Model (GCM).}
}

